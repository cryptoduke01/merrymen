# Server-only Solana configuration. Copy to .env.solana.local (gitignored).
# Do not put credentials in NEXT_PUBLIC_ variables or Robinhood RPC settings.
# The local npm commands load this file; hosted services use secret environments.
MERRYMEN_SOLANA_RPC_MAINNET=https://mainnet.helius-rpc.com/?api-key=REPLACE_WITH_YOUR_KEY
# Optional independent provider: a different hostname, also Solana mainnet.
# MERRYMEN_SOLANA_RPC_MAINNET_FALLBACK=https://YOUR_SECOND_PROVIDER
MERRYMEN_JUPITER_API_KEY=REPLACE_WITH_YOUR_KEY

# Shared app/worker storage. Required in hosted mode; local default is
# MERRYMEN_HOME/solana-accounts.sqlite (separate from the local paper CLI book).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# LIVE ONLY: leave unset until a reviewed immutable deployment is configured.
# The public program ID in contracts/solana is a LOCAL TEST identity.
# SHA256 covers ProgramData bytes after its 45-byte metadata INCLUDING padding.
# Verify the artifact plus known allocation padding before recording this hash.
# MERRYMEN_SOLANA_VAULT_PROGRAM=REPLACE_WITH_VERIFIED_PROGRAM_PUBLIC_KEY
# MERRYMEN_SOLANA_VAULT_SHA256=REPLACE_WITH_VERIFIED_64_CHARACTER_LOWERCASE_SHA256

# LIVE ONLY: each is canonical base64 for exactly 32 bytes, supplied privately.
# Preserve the DEK to decrypt existing sessions; share it across app and worker.
# Fee payer must be separate from owner and session. Never configure an owner key.
# MERRYMEN_STORE_DEK=REPLACE_WITH_PRIVATE_BASE64_32_BYTE_ENCRYPTION_KEY
# MERRYMEN_SOLANA_FEE_PAYER_SEED=REPLACE_WITH_PRIVATE_BASE64_32_BYTE_FEE_PAYER_SEED
# Defaults: fee + temporary rent ceiling (lamports), then priority price.
# MERRYMEN_SOLANA_MAX_FEE_LAMPORTS=5000000
# MERRYMEN_SOLANA_COMPUTE_UNIT_PRICE_MICROLAMPORTS=0
# How far (bps) a live trade's guaranteed output may sit below Pyth SOL/USD. 50–1000.
# MERRYMEN_SOLANA_REFERENCE_TOLERANCE_BPS=300

# Dedicated hosted Solana worker service ONLY; do not set this on the web service.
# MERRYMEN_START=start:solana
# MERRYMEN_SOLANA_SERVICE_ID=REPLACE_WITH_SOLANA_RAILWAY_SERVICE_ID
# MERRYMEN_FLEET_SERVICE_ID=REPLACE_WITH_DIFFERENT_RH_FLEET_SERVICE_ID
# Existing hosted authentication/image requirements still apply; see
# docs/hosted-deploy.md. This example does not deploy or enable a strategy.
